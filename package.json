{
  "name": "kakera-cho",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "check": "astro check",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:local": "wrangler d1 execute kakera --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute kakera --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute kakera --local --file=./migrations/0001_fts_trigram_search.sql",
    "db:migrate:remote": "wrangler d1 execute kakera --remote --file=./migrations/0001_fts_trigram_search.sql",
    "db:migrate:link-card:local": "wrangler d1 execute kakera --local --file=./migrations/0002_link_card.sql",
    "db:migrate:link-card:remote": "wrangler d1 execute kakera --remote --file=./migrations/0002_link_card.sql",
    "db:migrate:name-map:local": "wrangler d1 execute kakera --local --file=./migrations/0003_name_map.sql",
    "db:migrate:name-map:remote": "wrangler d1 execute kakera --remote --file=./migrations/0003_name_map.sql",
    "db:migrate:katachi-kakera:local": "wrangler d1 execute kakera --local --file=./migrations/0004_katachi_kakera.sql",
    "db:migrate:katachi-kakera:remote": "wrangler d1 execute kakera --remote --file=./migrations/0004_katachi_kakera.sql",
    "db:migrate:written-order:local": "wrangler d1 execute kakera --local --file=./migrations/0005_katachi_written_order.sql",
    "db:migrate:written-order:remote": "wrangler d1 execute kakera --remote --file=./migrations/0005_katachi_written_order.sql",
    "db:migrate:photo-choice:local": "wrangler d1 execute kakera --local --file=./migrations/0006_photo_choice.sql",
    "db:migrate:photo-choice:remote": "wrangler d1 execute kakera --remote --file=./migrations/0006_photo_choice.sql",
    "db:migrate:description:local": "wrangler d1 execute kakera --local --file=./migrations/0007_nikki_description.sql",
    "db:migrate:description:remote": "wrangler d1 execute kakera --remote --file=./migrations/0007_nikki_description.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/preact": "^4.1.1",
    "astro": "^5.14.1",
    "jose": "^6.1.0",
    "octokit": "^5.0.3",
    "preact": "^10.27.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  }
}
