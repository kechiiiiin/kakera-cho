{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["dist", ".wrangler", "src/**/*.test.ts", "vitest.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["astro/client", "@cloudflare/workers-types"],
    "strictNullChecks": true,
    "noUnusedLocals": true
  }
}
